{
  "name": "sijong-v1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run --project server",
    "test:web": "vitest run --project web",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build apps/web --config apps/web/vite.config.ts",
    "build:web": "vite build apps/web --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/main.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "seed:demo": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/seed-demo.ts",
    "teacher:password": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/teacher-password.ts",
    "backup": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/backup.ts",
    "format:check": "prettier --check apps packages scripts tests *.ts *.json .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
